# Copy this file to .env and fill in the values:
#   cp .env.example .env
# Never commit .env — it is git-ignored.

# --- PostgreSQL --------------------------------------------------------------
# Used by both the Postgres container (docker-compose) and the app.
POSTGRES_USER=news
# Required: the app refuses to start without it. Generate one with:
#   openssl rand -hex 24
POSTGRES_PASSWORD=change-me
POSTGRES_DB=news_sentiment
# "localhost" when running the app on your machine; docker-compose
# overrides this to "db" inside the containers.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional: a full connection string that takes precedence over the
# POSTGRES_* values above (e.g. injected by Heroku, Neon, Coolify).
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

# --- Ingestion ---------------------------------------------------------------
# Comma-separated list of RSS feed URLs.
RSS_FEEDS=http://feeds.bbci.co.uk/news/rss.xml
# How often the worker polls the feeds, in seconds.
POLL_INTERVAL_SECONDS=300

# --- Model -------------------------------------------------------------------
# Any Hugging Face sentiment-analysis model.
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
